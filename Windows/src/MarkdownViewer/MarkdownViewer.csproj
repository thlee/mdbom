<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>MarkdownViewer</AssemblyName>
    <RootNamespace>MarkdownViewer</RootNamespace>
    <Product>엠디봄</Product>
    <Title>엠디봄</Title>
    <Description>A local, read-only Markdown viewer for Windows.</Description>
    <Version>1.0.0-beta.4</Version>
    <FileVersion>1.0.0.15</FileVersion>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <DebugType>embedded</DebugType>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4191.47" />
    <EmbeddedResource Include="Assets\**\*" Exclude="Assets\app.ico">
      <LogicalName>Assets/%(RecursiveDir)%(Filename)%(Extension)</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="..\..\..\Shared\Renderer\Resources\Web\*">
      <Link>Assets/%(Filename)%(Extension)</Link>
      <LogicalName>Assets/%(Filename)%(Extension)</LogicalName>
    </EmbeddedResource>
    <Resource Include="Assets\app.ico" />
    <EmbeddedResource Include="..\..\..\Shared\Renderer\Resources\Tests\*">
      <LogicalName>Tests/%(Filename)%(Extension)</LogicalName>
    </EmbeddedResource>
  </ItemGroup>
</Project>
