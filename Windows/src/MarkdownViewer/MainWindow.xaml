<Window x:Class="MarkdownViewer.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
 Title="엠디봄" Width="1120" Height="820" MinWidth="760" MinHeight="480"
 FontFamily="Segoe UI" FontSize="13" Icon="Assets/app.ico"
 Background="{DynamicResource WindowBrush}" Foreground="{DynamicResource TextBrush}"
 WindowStartupLocation="CenterScreen" AllowDrop="True"
 DragOver="Window_DragOver" Drop="Window_Drop" Loaded="Window_Loaded" Closed="Window_Closed">
 <DockPanel>
  <Border DockPanel.Dock="Bottom" Padding="18,6" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Background="{DynamicResource PanelBrush}">
   <DockPanel>
    <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
     <TextBlock x:Name="ReadOnlyLabel" Text="읽기 전용" Foreground="{DynamicResource MutedBrush}" FontSize="10" VerticalAlignment="Center" Margin="0,0,18,0" />
     <Button Content="−" Padding="8,0" Margin="0" Click="ZoomOut_Click" ToolTip="Zoom out (Ctrl+−)" AutomationProperties.Name="Zoom out" />
     <Button x:Name="ZoomButton" Content="100%" Padding="7,2" Margin="3,0" BorderThickness="0" Click="ResetZoom_Click" ToolTip="Reset zoom (Ctrl+0)" AutomationProperties.Name="Reset zoom" />
     <Button Content="+" Padding="8,0" Margin="0" Click="ZoomIn_Click" ToolTip="Zoom in (Ctrl++)" AutomationProperties.Name="Zoom in" />
    </StackPanel>
    <TextBlock x:Name="StatusLabel" Text="Ready · Local files only" VerticalAlignment="Center" Foreground="{DynamicResource MutedBrush}" TextTrimming="CharacterEllipsis" />
   </DockPanel>
  </Border>
  <Grid>
   <wv2:WebView2 x:Name="Browser" AllowExternalDrop="True" DefaultBackgroundColor="White" />
   <Border x:Name="StartupPanel" Background="{DynamicResource WindowBrush}">
    <TextBlock x:Name="StartupText" Text="Starting 엠디봄…" HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="580" Margin="30" />
   </Border>
  </Grid>
 </DockPanel>
</Window>
